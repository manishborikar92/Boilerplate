{
  "name": "server-platform",
  "version": "1.0.0",
  "description": "Lightweight multi-app backend platform",
  "private": true,
  "type": "module",
  "main": "hosts/gateway/src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "hosts/*"
  ],
  "scripts": {
    "dev": "node --watch hosts/gateway/src/server.js",
    "start": "node hosts/gateway/src/server.js",
    "test": "node --test --test-isolation=none --test-concurrency=1 tests/**/*.test.js",
    "lint": "eslint .",
    "app:new": "node scripts/create-app.mjs",
    "module:new": "node scripts/create-module.mjs"
  },
  "keywords": [
    "express",
    "workspace",
    "multi-app",
    "backend",
    "platform",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "joi": "^18.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  }
}
