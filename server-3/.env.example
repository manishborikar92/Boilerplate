# EverCut Backend Environment
# Copy to .env and fill real values for your local, staging, or production setup.
# Never commit .env or real provider credentials.

# ---------------------------------------------------------------------------
# APP CONFIG
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Required only when NODE_ENV=production.
# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# DATABASE CONFIG
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://evercut_user:replace_with_password@cluster0.mongodb.net/evercut_dev?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# AUTH CONFIG
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_64_plus_random_chars_for_access_tokens
JWT_REFRESH_SECRET=replace_with_different_64_plus_random_chars_for_refresh_tokens
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=180d

# ---------------------------------------------------------------------------
# FIREBASE CONFIG
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=evercut-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@evercut-dev.iam.gserviceaccount.com
# Keep this value quoted and use literal \n line breaks from the service-account JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: used by server/scripts/firebase-token-gen.js to exchange custom tokens.
FIREBASE_API_KEY=replace_with_firebase_web_api_key

# ---------------------------------------------------------------------------
# MSG91 CONFIG
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=replace_with_msg91_otp_template_id

# ---------------------------------------------------------------------------
# CLOUDINARY CONFIG
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=evercut-dev
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# ---------------------------------------------------------------------------
# PAYMENT GATEWAY CONFIG - PHONEPE COLLECTION
# ---------------------------------------------------------------------------
# PHONEPE_ENV: SANDBOX or PRODUCTION.
# Leave credential values blank only for non-production smoke tests that do not
# call live PhonePe APIs. Production startup requires real non-empty values.
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=

# PhonePe webhook Authorization is SHA256(username:password) in this backend.
# Set these in PhonePe dashboard and keep Postman variables in sync.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Must be publicly reachable for real PhonePe redirects/webhooks.
PAYMENT_REDIRECT_BASE_URL=http://localhost:5000/api/v1/payments/redirect

# ---------------------------------------------------------------------------
# PAYOUT CONFIG - CASHFREE PAYOUTS
# ---------------------------------------------------------------------------
# CASHFREE_PAYOUT_ENV: SANDBOX or PRODUCTION.
# Leave credential values blank only for non-production smoke tests that do not
# call live Cashfree APIs. Production startup requires real non-empty values.
CASHFREE_PAYOUT_ENV=SANDBOX
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL FLAGS / SANDBOX NOTES
# ---------------------------------------------------------------------------
# PhonePe base URL is derived from PHONEPE_ENV.
# Cashfree payout base URL is derived from CASHFREE_PAYOUT_ENV.
# MSG91 OTP test mode is enabled automatically when NODE_ENV is not production.
# Payment fees, refund fees, bundle minimums, poll intervals, and payout batch
# time are code-level business rules in server/src/config/index.js.
