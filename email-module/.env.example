# ─── Email Configuration ──────────────────────────────────────────────────────
# Only configure the provider you plan to use. SMTP is the default.

# ── Shared ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── SMTP (default — providers/SmtpProvider.js) ───────────────────────────────
# For Gmail: Use an App Password, not your regular password.
# For development: Leave blank to auto-use Ethereal (https://ethereal.email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="MyApp" <no-reply@myapp.com>

# ── Resend (providers/ResendProvider.js) ─────────────────────────────────────
# npm install resend
# Get API key from https://resend.com/api-keys
# Verify domain at https://resend.com/domains
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=MyApp <no-reply@your-verified-domain.com>

# ── Brevo (providers/BrevoProvider.js) ───────────────────────────────────────
# npm install @getbrevo/brevo
# Get API key from https://app.brevo.com/settings/keys/api
# Register sender at https://app.brevo.com/senders
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_FROM=no-reply@your-verified-domain.com
# BREVO_FROM_NAME=MyApp

# ── MailerSend (providers/MailerSendProvider.js) ─────────────────────────────
# npm install mailersend
# Get API token from https://app.mailersend.com/api-tokens
# Verify domain at https://app.mailersend.com/domains
# MAILERSEND_API_KEY=mlsn.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILERSEND_FROM=no-reply@your-verified-domain.com
# MAILERSEND_FROM_NAME=MyApp
