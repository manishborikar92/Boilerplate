# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ca-flow

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRE=30d

# ─── Email Configuration ──────────────────────────────────────────────────────
# ACTIVE PROVIDER: Resend (services/resendService.js + config/resend.js)
# Alternative: SMTP (services/emailService.js)
# To switch provider, change the require() path in consumer files.

# ── Resend (ACTIVE — services/resendService.js + config/resend.js) ───────────
# Get API key from https://resend.com/api-keys
# Verify domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=CA-Workflow <no-reply@your-verified-domain.com>

# ── SMTP (INACTIVE — services/emailService.js) ───────────────────────────────
# For Gmail: Use App Password (not your regular password)
# For development: Leave blank to auto-use Ethereal (https://ethereal.email)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=email@gmail.com
# EMAIL_PASS=sdfr tyuj swik lpgv
# EMAIL_FROM="CA-Flow" <no-reply@ca-flow.com>

# Firebase (Get from Firebase Console)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Cloudinary Configuration (Required for file uploads)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay Configuration (Required for payments)
# Get credentials from https://dashboard.razorpay.com/app/keys
# For testing, use Test Mode keys (rzp_test_xxx)
# For production, use Live Mode keys (rzp_live_xxx) after KYC completion
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Subscription Plan IDs
# Generated on 2026-01-29 by server/scripts/create_razorpay_plans.js
RAZORPAY_PLAN_MONTHLY_ID=plan_S9cCvtgh943jZm     # CA Flow - Pro Monthly - ₹349
RAZORPAY_PLAN_QUARTERLY_ID=plan_S9cCwSwGnIRtAW   # CA Flow - Pro Quarterly - ₹799
RAZORPAY_PLAN_HALFYEARLY_ID=plan_S9cCx34gVfrZF3  # CA Flow - Pro Half-Yearly - ₹1,299

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=ca-flow-documents

# Twilio Configuration (Required for SMS and WhatsApp notifications)
# Get credentials from https://console.twilio.com
# For testing, use Twilio Trial Account
# For production, upgrade to paid account
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_WHATSAPP_TEMPLATE_NOTIFICATION_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Test Phone Number (for testing Twilio integration)
TEST_PHONE_NUMBER=+919876543210
